APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Redis dipakai kalau CACHE_DRIVER/QUEUE_CONNECTION/SESSION_DRIVER di atas
# diset ke "redis" (docker-compose.yml melakukan ini otomatis untuk container
# app). REDIS_CLIENT=predis karena predis/predis (pure PHP) sudah terpasang —
# tidak butuh ekstensi phpredis di image PHP.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- AI Providers ---
# Default text provider: gemini (kuota gratis Google AI Studio, jauh lebih cepat/stabil
# daripada model :free di OpenRouter). Ganti ke "openrouter" lewat halaman Settings admin
# atau env ini kalau perlu.
AI_TEXT_PROVIDER=gemini
AI_TRANSCRIPTION_PROVIDER=whisper_local
AI_HTTP_TIMEOUT=60

# Fallback: kalau provider aktif gagal/timeout, AiManager mencoba daftar ini
# berurutan sebelum menyerah (comma-separated, nama dari config/ai.php). Teks
# jatuh ke openrouter secara default (butuh OPENAI_API_KEY); kosongkan untuk mati.
AI_TEXT_FALLBACKS=openrouter
AI_TRANSCRIPTION_FALLBACKS=
AI_OCR_FALLBACKS=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URI=https://openrouter.ai/api/v1
OPENAI_REQUEST_TIMEOUT=30
AI_OPENROUTER_MODEL=openai/gpt-oss-20b:free

GEMINI_API_KEY=
GEMINI_REQUEST_TIMEOUT=60
AI_GEMINI_MODEL=gemini-2.0-flash

# Whisper STT sidecar. Docker Compose starts it as the "whisper" service and
# overrides this to http://whisper:5055/transcribe. For local dev without Docker,
# run it yourself: pip install -r docker/whisper/requirements.txt && python docker/whisper/stt_service.py
STT_SERVICE_URL=http://127.0.0.1:5055/transcribe
# WHISPER_MODEL=base   # tiny | base | small | medium | large — bigger = slower + more RAM

# --- SSO (login Google/Microsoft, hanya untuk akun yang sudah terdaftar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
